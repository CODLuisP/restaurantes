# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: API key de Google Cloud Console con
# Maps JavaScript API + Geocoding API + Places API habilitadas.
# Se usa en Configuración > Información del negocio > Ubicación.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyDjSwibBACnjf7AZXR2sj1yBUEMGq2o1ho"

# API_URL: URL base del backend RestaurantesAPI (.NET). NextAuth lo llama
# desde el servidor (Route Handler / Server Actions), nunca desde el cliente.
API_URL="http://localhost:5004"

# NEXT_PUBLIC_API_URL: misma URL, pero accesible desde componentes cliente
# ('use client') para llamar directo al backend (ej. módulos CRUD del dashboard).
NEXT_PUBLIC_API_URL="http://localhost:5004"

# AUTH_SECRET: clave usada por NextAuth para firmar/cifrar la sesión (JWT).
# Generar una nueva por entorno: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET="MY_AUTH_SECRET"

# SUNAT_API_URL / SUNAT_API_TOKEN: Proveedor OSE/SUNAT de facturación electrónica
# (Nubefact, Facturactiva, etc.) para emitir Boletas y Facturas desde /cobrar.
# Si se dejan vacías, el endpoint /api/emitir-comprobante opera en MODO DEMO
# (simula la aceptación de SUNAT sin enviar nada real).
SUNAT_API_URL=""
SUNAT_API_TOKEN=""

# JSONPE_API_KEY: token de api.json.pe (consulta DNI/RUC) usado server-side por
# /api/consultar-ruc (Configuración > Datos del negocio) y /api/consultar-dni (Cobrar,
# para autocompletar nombre/razón social del comprobante). Sin token, ambos endpoints
# devuelven error al consultar.
JSONPE_API_KEY=""

# MAILERSEND_API_KEY / MAILERSEND_FROM_EMAIL / MAILERSEND_FROM_NAME: proveedor de email
# transaccional (mailersend.com) usado por /api/comprobantes/enviar-correo para reenviar el
# PDF de un comprobante por correo desde /comprobantes. MAILERSEND_FROM_EMAIL debe ser una
# dirección del dominio verificado en la cuenta de MailerSend. Si se dejan vacías, el
# endpoint opera en MODO DEMO (simula el envío).
MAILERSEND_API_KEY=""
MAILERSEND_FROM_EMAIL=""
MAILERSEND_FROM_NAME=""

# WHATSAPP_API_URL / WHATSAPP_API_KEY: pasarela de WhatsApp (sube el PDF y lo envía como
# documento) usada por /api/comprobantes/enviar-whatsapp desde /comprobantes. Si se dejan
# vacías, el endpoint opera en MODO DEMO (simula el envío).
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN: cuenta de Cloudflare Images
# usada por /api/upload-imagen para subir y eliminar fotos de productos.
# El token requiere el permiso "Cloudflare Images: Edit".
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# CLOUDFLARE_ACCOUNT_ID_AI / CLOUDFLARE_AI_TOKEN: cuenta de Cloudflare Workers AI usada
# solo en el servidor por /api/leer-carta (Menú Digital > Importar) para leer cartas en foto o
# PDF. El token requiere el permiso "Workers AI: Read". Sin ellas, la importación con IA
# responde que no está configurada.
CLOUDFLARE_ACCOUNT_ID_AI=""
CLOUDFLARE_AI_TOKEN=""

# NEXT_PUBLIC_DOMINIO_BASE: dominio principal del sistema, sin "https://" ni "www" (ej.
# restofly.com.pe). Cada empresa puede elegir su subdominio en Menú Digital > QR y Link de la
# Carta y su carta queda en https://<subdominio>.<dominio>/menu (requiere DNS y SSL comodín
# *.<dominio>). Vacío en desarrollo: se usa http://<subdominio>.localhost:<puerto>/menu.
NEXT_PUBLIC_DOMINIO_BASE=""
